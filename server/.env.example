# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/feedback-collector

# JWT secret (change in production)
JWT_SECRET=your_secret_here

# Server port
PORT=5000

# CORS origin (frontend URL in production)
CORS_ORIGIN=http://localhost:5173

# JWT token expiry (default: 30d)
JWT_EXPIRES_IN=30d

# Rate limiting for public feedback (window in minutes, max requests)
RATE_LIMIT_WINDOW_MS=15
RATE_LIMIT_MAX=10

# Login rate limiting
LOGIN_RATE_LIMIT_MAX=5

# Admin seed defaults (can override)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=iamadmin
